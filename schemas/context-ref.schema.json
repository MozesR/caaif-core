  "title": "CAAIF Context Reference (draft)",
  "type": "object",
  "required": [
    "ref",
    "version",
    "scope"
  ],
  "additionalProperties": false,
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
