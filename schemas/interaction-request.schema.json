{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAAIF Interaction Request (draft)",
  "type": "object",
  "required": [
    "spec_version",
    "request_id",
    "correlation_id",
    "contract_id",
    "contract_version",
    "caller_id",
    "recipient_id",
    "capability",
    "context_refs",
    "input",
    "expires_at"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "1.0.0-draft.2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "caller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recipient_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "context_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "title": "CAAIF Context Reference (draft)",
        "type": "object",
        "required": [
          "ref",
          "version",
          "scope"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "input": {
      "type": "object",
      "maxProperties": 128
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
