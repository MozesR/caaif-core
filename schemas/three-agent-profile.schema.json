{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAAIF Three-Agent Reference Profile (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "profile_id",
    "version",
    "roles",
    "allowed_edges",
    "task_guards"
  ],
  "properties": {
    "spec_version": {
      "const": "1.0.0-draft.2"
    },
    "profile_id": {
      "const": "caaif.profile.three-agent.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversational",
        "reasoning",
        "task"
      ],
      "properties": {
        "conversational": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "reasoning": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "task": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "allowed_edges": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_role",
          "to_role",
          "contract_id",
          "capability"
        ],
        "properties": {
          "from_role": {
            "enum": [
              "conversational",
              "reasoning",
              "task"
            ]
          },
          "to_role": {
            "enum": [
              "conversational",
              "reasoning",
              "task"
            ]
          },
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_trusted_reasoning_decision",
        "independent_dispatch_policy",
        "forbid_conversational_to_task"
      ],
      "properties": {
        "require_trusted_reasoning_decision": {
          "const": true
        },
        "independent_dispatch_policy": {
          "const": true
        },
        "forbid_conversational_to_task": {
          "const": true
        }
      }
    }
  }
}
